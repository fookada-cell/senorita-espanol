 "blocks": [
  {
   "t": "h",
   "es": "1 · En el puesto de verduras",
   "en": ""
  },
  {
   "t": "d",
   "es": "¡Buenos días! ¿[[c1_que_te_pongo|Qué te pongo]]?",
   "en": "Good morning! What can I get you?",
   "who": "Frutero",
   "audio": "audio/c1_01_Frutero.mp3"
  },
  {
   "t": "d",
   "es": "Buenos días. ¿[[c1_a_cuanto_esta_el_kilo|A cuánto está el kilo]] de tomates?",
   "en": "Good morning. How much is a kilo of tomatoes?",
   "who": "Marina",
   "audio": "audio/c1_02_Marina.mp3"
  },
  {
   "t": "d",
   "es": "A dos euros el kilo. Están muy maduros.",
   "en": "Two euros a kilo. They're very ripe.",
   "who": "Frutero",
   "audio": "audio/c1_03_Frutero.mp3"
  },
  {
   "t": "d",
   "es": "¡[[c1_esta_tirado|Está tirado]]! Un kilo, por favor.",
   "en": "That's dirt cheap! A kilo, please.",
   "who": "Marina",
   "audio": "audio/c1_04_Marina.mp3"
  },
  {
   "t": "d",
   "es": "Aquí tienes. ¿[[c1_algo_mas|Algo más]]?",
   "en": "Here you are. Anything else?",
   "who": "Frutero",
   "audio": "audio/c1_05_Frutero.mp3"
  },
  {
   "t": "d",
   "es": "Sí, un pepino y dos pimientos verdes.",
   "en": "Yes, a cucumber and two green peppers.",
   "who": "Marina",
   "audio": "audio/c1_06_Marina.mp3"
  },
  {
   "t": "d",
   "es": "¿Son para un gazpacho?",
   "en": "Are they for a gazpacho?",
   "who": "Frutero",
   "audio": "audio/c1_07_Frutero.mp3"
  },
  {
   "t": "d",
   "es": "¡Sí! Para mi clase de cocina.",
   "en": "Yes! For my cooking class.",
   "who": "Marina",
   "audio": "audio/c1_08_Marina.mp3"
  },
  {
   "t": "d",
   "es": "Entonces necesitas ajo. ¿Una cabeza?",
   "en": "Then you need garlic. A head?",
   "who": "Frutero",
   "audio": "audio/c1_09_Frutero.mp3"
  },
  {
   "t": "d",
   "es": "Sí, gracias. ¿[[c1_cuanto_es_todo|Cuánto es todo]]?",
   "en": "Yes, thanks. How much is everything?",
   "who": "Marina",
   "audio": "audio/c1_10_Marina.mp3"
  },
  {
   "t": "d",
   "es": "Cuatro euros con cincuenta.",
   "en": "Four euros fifty.",
   "who": "Frutero",
   "audio": "audio/c1_11_Frutero.mp3"
  },
  {
   "t": "d",
   "es": "¿[[c1_puedo_pagar_con_tarjeta|Puedo pagar con tarjeta]]?",
   "en": "Can I pay by card?",
   "who": "Marina",
   "audio": "audio/c1_12_Marina.mp3"
  },
  {
   "t": "d",
   "es": "Claro. ¡Que te salga muy rico el gazpacho!",
   "en": "Of course. I hope your gazpacho turns out delicious!",
   "who": "Frutero",
   "audio": "audio/c1_13_Frutero.mp3"
  },
  {
   "t": "h",
   "es": "2 · En la tienda de aceite",
   "en": ""
  },
  {
   "t": "d",
   "es": "Hola, buenos días. ¿Quieres probar nuestro aceite de oliva?",
   "en": "Hello, good morning. Would you like to taste our olive oil?",
   "who": "Aceitera",
   "audio": "audio/c2_01_Aceitera.mp3"
  },
  {
   "t": "d",
   "es": "¡Sí, por favor!",
   "en": "Yes, please!",
   "who": "Marina",
   "audio": "audio/c2_02_Marina.mp3"
  },
  {
   "t": "d",
   "es": "Toma un [[c2_trozo_de_pan|trozo de pan]]. Es aceite de Jaén.",
   "en": "Take a piece of bread. It's oil from Jaén.",
   "who": "Aceitera",
   "audio": "audio/c2_03_Aceitera.mp3"
  },
  {
   "t": "d",
   "es": "Mmm… ¡[[c2_que_rico|Qué rico]]!",
   "en": "Mmm… How delicious!",
   "who": "Marina",
   "audio": "audio/c2_04_Marina.mp3"
  },
  {
   "t": "d",
   "es": "¿Verdad? Es muy suave.",
   "en": "Isn't it? It's very smooth.",
   "who": "Aceitera",
   "audio": "audio/c2_05_Aceitera.mp3"
  },
  {
   "t": "d",
   "es": "¿Cuánto cuesta esta botella?",
   "en": "How much does this bottle cost?",
   "who": "Marina",
   "audio": "audio/c2_06_Marina.mp3"
  },
  {
   "t": "d",
   "es": "La grande, doce euros. La pequeña, seis.",
   "en": "The big one, twelve euros. The small one, six.",
   "who": "Aceitera",
   "audio": "audio/c2_07_Aceitera.mp3"
  },
  {
   "t": "d",
   "es": "[[c2_es_un_poco_caro|Es un poco caro]]… La pequeña, por favor.",
   "en": "It's a bit expensive… The small one, please.",
   "who": "Marina",
   "audio": "audio/c2_08_Marina.mp3"
  },
  {
   "t": "d",
   "es": "Muy bien. ¿Necesitas algo más?",
   "en": "Very good. Do you need anything else?",
   "who": "Aceitera",
   "audio": "audio/c2_09_Aceitera.mp3"
  },
  {
   "t": "d",
   "es": "Sí, también una botella de vinagre.",
   "en": "Yes, also a bottle of vinegar.",
   "who": "Marina",
   "audio": "audio/c2_10_Marina.mp3"
  },
  {
   "t": "d",
   "es": "Aquí tienes. Son ocho euros [[c2_en_total|en total]].",
   "en": "Here you are. That's eight euros in total.",
   "who": "Aceitera",
   "audio": "audio/c2_11_Aceitera.mp3"
  },
  {
   "t": "d",
   "es": "Muy bien. ¡Muchas gracias!",
   "en": "Great. Thank you very much!",
   "who": "Marina",
   "audio": "audio/c2_12_Marina.mp3"
  },
  {
   "t": "d",
   "es": "A ti. ¡Y vuelve pronto!",
   "en": "Thank you. And come back soon!",
   "who": "Aceitera",
   "audio": "audio/c2_13_Aceitera.mp3"
  },
  {
   "t": "h",
   "es": "3 · En el bar del mercado",
   "en": ""
  },
  {
   "t": "d",
   "es": "¡Hola! ¿[[c3_que_os_pongo|Qué os pongo]]?",
   "en": "Hi! What can I get you two?",
   "who": "Camarero",
   "audio": "audio/c3_01_Camarero.mp3"
  },
  {
   "t": "d",
   "es": "Para mí, un [[c3_cafe_con_leche|café con leche]], por favor.",
   "en": "For me, a white coffee, please.",
   "who": "Marina",
   "audio": "audio/c3_02_Marina.mp3"
  },
  {
   "t": "d",
   "es": "¿Y para tu amiga?",
   "en": "And for your friend?",
   "who": "Camarero",
   "audio": "audio/c3_03_Camarero.mp3"
  },
  {
   "t": "d",
   "es": "Un zumo de naranja.",
   "en": "An orange juice.",
   "who": "Marina",
   "audio": "audio/c3_04_Marina.mp3"
  },
  {
   "t": "d",
   "es": "¿Algo de comer?",
   "en": "Anything to eat?",
   "who": "Camarero",
   "audio": "audio/c3_05_Camarero.mp3"
  },
  {
   "t": "d",
   "es": "Sí. ¿[[c3_que_tapas_teneis|Qué tapas tenéis]]?",
   "en": "Yes. What tapas do you have?",
   "who": "Marina",
   "audio": "audio/c3_06_Marina.mp3"
  },
  {
   "t": "d",
   "es": "Tortilla de patatas, croquetas y pan con tomate.",
   "en": "Potato omelette, croquettes and bread with tomato.",
   "who": "Camarero",
   "audio": "audio/c3_07_Camarero.mp3"
  },
  {
   "t": "d",
   "es": "Una tapa de tortilla [[c3_para_compartir|para compartir]].",
   "en": "A tapa of omelette to share.",
   "who": "Marina",
   "audio": "audio/c3_08_Marina.mp3"
  },
  {
   "t": "d",
   "es": "Muy bien. ¿Algo más?",
   "en": "Very good. Anything else?",
   "who": "Camarero",
   "audio": "audio/c3_09_Camarero.mp3"
  },
  {
   "t": "d",
   "es": "No, nada más, gracias.",
   "en": "No, nothing else, thanks.",
   "who": "Marina",
   "audio": "audio/c3_10_Marina.mp3"
  },
  {
   "t": "d",
   "es": "Aquí tenéis. ¡Que aproveche!",
   "en": "Here you are. Enjoy!",
   "who": "Camarero",
   "audio": "audio/c3_11_Camarero.mp3"
  },
  {
   "t": "d",
   "es": "¿[[c3_me_cobras|Me cobras]], por favor?",
   "en": "Can I pay, please?",
   "who": "Marina",
   "audio": "audio/c3_12_Marina.mp3"
  },
  {
   "t": "d",
   "es": "Son cinco euros con veinte.",
   "en": "That's five euros twenty.",
   "who": "Camarero",
   "audio": "audio/c3_13_Camarero.mp3"
  },
  {
   "t": "h",
   "es": "4 · A la salida del mercado",
   "en": ""
  },
  {
   "t": "d",
   "es": "¡Espera, Marina! [[c4_falta_algo|Falta algo]] en la lista.",
   "en": "Wait, Marina! Something's missing from the list.",
   "who": "Laura",
   "audio": "audio/c4_01_Laura.mp3"
  },
  {
   "t": "d",
   "es": "¿Qué falta?",
   "en": "What's missing?",
   "who": "Marina",
   "audio": "audio/c4_02_Marina.mp3"
  },
  {
   "t": "d",
   "es": "¡La sal!",
   "en": "The salt!",
   "who": "Laura",
   "audio": "audio/c4_03_Laura.mp3"
  },
  {
   "t": "d",
   "es": "¡Ay, [[c4_es_verdad|es verdad]]! Vamos a otro puesto.",
   "en": "Oh, that's true! Let's go to another stall.",
   "who": "Marina",
   "audio": "audio/c4_04_Marina.mp3"
  },
  {
   "t": "d",
   "es": "Vale. ¡Uf, las [[c4_bolsas_pesan_mucho|bolsas pesan mucho]]!",
   "en": "OK. Phew, the bags are really heavy!",
   "who": "Laura",
   "audio": "audio/c4_05_Laura.mp3"
  },
  {
   "t": "d",
   "es": "Sí, pero ya tenemos todo para la clase.",
   "en": "Yes, but now we have everything for the class.",
   "who": "Marina",
   "audio": "audio/c4_06_Marina.mp3"
  },
  {
   "t": "d",
   "es": "Oye, ¿quieres [[c4_cocinar_juntas|cocinar juntas]] un día en tu casa?",
   "en": "Hey, do you want to cook together one day at your place?",
   "who": "Laura",
   "audio": "audio/c4_07_Laura.mp3"
  },
  {
   "t": "d",
   "es": "¡Claro! ¿El próximo sábado?",
   "en": "Of course! Next Saturday?",
   "who": "Marina",
   "audio": "audio/c4_08_Marina.mp3"
  },
  {
   "t": "d",
   "es": "¡[[c4_venga|Venga]]! Me encanta la idea.",
   "en": "Great! I love the idea.",
   "who": "Laura",
   "audio": "audio/c4_09_Laura.mp3"
  },
  {
   "t": "d",
   "es": "¿Qué preparamos?",
   "en": "What shall we make?",
   "who": "Marina",
   "audio": "audio/c4_10_Marina.mp3"
  },
  {
   "t": "d",
   "es": "¿Una tortilla de patatas?",
   "en": "A Spanish omelette?",
   "who": "Laura",
   "audio": "audio/c4_11_Laura.mp3"
  },
  {
   "t": "d",
   "es": "Vale. ¡Yo hago la tortilla y tú el postre!",
   "en": "OK. I'll make the omelette and you make dessert!",
   "who": "Marina",
   "audio": "audio/c4_12_Marina.mp3"
  },
  {
   "t": "d",
   "es": "¡[[c4_trato_hecho|Trato hecho]]! Hasta el sábado.",
   "en": "Deal! See you on Saturday.",
   "who": "Laura",
   "audio": "audio/c4_13_Laura.mp3"
  },
  {
   "t": "v",
   "es": "Frases clave de la semana"
  }
