 "blocks": [
  {
   "t": "h",
   "es": "1 · En la panadería (lunes, 10:00)",
   "en": ""
  },
  {
   "t": "d",
   "es": "¡Buenos días! ¿[[c1_que_te_pongo|Qué te pongo]]?",
   "en": "Good morning! What can I get you?",
   "who": "Panadero",
   "audio": "audio/c1_01_Panadero.mp3"
  },
  {
   "t": "d",
   "es": "Hola, buenos días. Una [[c1_barra_de_pan|barra de pan]], por favor.",
   "en": "Hi, good morning. A baguette, please.",
   "who": "Elena",
   "audio": "audio/c1_02_Elena.mp3"
  },
  {
   "t": "d",
   "es": "Aquí tienes. ¿[[c1_algo_mas|Algo más]]?",
   "en": "Here you are. Anything else?",
   "who": "Panadero",
   "audio": "audio/c1_03_Panadero.mp3"
  },
  {
   "t": "d",
   "es": "No, gracias. ¡Qué bien huele el pan!",
   "en": "No, thanks. The bread smells so good!",
   "who": "Elena",
   "audio": "audio/c1_04_Elena.mp3"
  },
  {
   "t": "d",
   "es": "Es pan del día. ¿Eres nueva en el barrio?",
   "en": "It's fresh today. Are you new in the neighbourhood?",
   "who": "Panadero",
   "audio": "audio/c1_05_Panadero.mp3"
  },
  {
   "t": "d",
   "es": "Sí, [[c1_acabo_de_mudarme|acabo de mudarme]] a Madrid.",
   "en": "Yes, I've just moved to Madrid.",
   "who": "Elena",
   "audio": "audio/c1_06_Elena.mp3"
  },
  {
   "t": "d",
   "es": "¡Bienvenida! ¿Y te gusta el barrio?",
   "en": "Welcome! And do you like the neighbourhood?",
   "who": "Panadero",
   "audio": "audio/c1_07_Panadero.mp3"
  },
  {
   "t": "d",
   "es": "Sí, mucho. Lo conozco [[c1_poco_a_poco|poco a poco]].",
   "en": "Yes, a lot. I'm getting to know it little by little.",
   "who": "Elena",
   "audio": "audio/c1_08_Elena.mp3"
  },
  {
   "t": "d",
   "es": "Son ochenta céntimos.",
   "en": "That's eighty cents.",
   "who": "Panadero",
   "audio": "audio/c1_09_Panadero.mp3"
  },
  {
   "t": "d",
   "es": "Aquí tienes. ¿[[c1_abris_todos_los_dias|Abrís todos los días]]?",
   "en": "Here you are. Are you open every day?",
   "who": "Elena",
   "audio": "audio/c1_10_Elena.mp3"
  },
  {
   "t": "d",
   "es": "Sí, de lunes a sábado, desde las ocho.",
   "en": "Yes, Monday to Saturday, from eight.",
   "who": "Panadero",
   "audio": "audio/c1_11_Panadero.mp3"
  },
  {
   "t": "d",
   "es": "Perfecto. Entonces, hasta mañana.",
   "en": "Perfect. See you tomorrow, then.",
   "who": "Elena",
   "audio": "audio/c1_12_Elena.mp3"
  },
  {
   "t": "d",
   "es": "¡Hasta mañana!",
   "en": "See you tomorrow!",
   "who": "Panadero",
   "audio": "audio/c1_13_Panadero.mp3"
  },
  {
   "t": "h",
   "es": "2 · En el espacio compartido (miércoles, 10:00)",
   "en": ""
  },
  {
   "t": "d",
   "es": "Hola, ¿[[c2_eres_nueva_aqui|eres nueva aquí]]?",
   "en": "Hi, are you new here?",
   "who": "Javier",
   "audio": "audio/c2_01_Javier.mp3"
  },
  {
   "t": "d",
   "es": "Sí, hola. Me llamo Elena.",
   "en": "Yes, hi. My name is Elena.",
   "who": "Elena",
   "audio": "audio/c2_02_Elena.mp3"
  },
  {
   "t": "d",
   "es": "Encantado, Elena. Yo soy Javier.",
   "en": "Nice to meet you, Elena. I'm Javier.",
   "who": "Javier",
   "audio": "audio/c2_03_Javier.mp3"
  },
  {
   "t": "d",
   "es": "Encantada. Acabo de mudarme a Madrid. Vivo cerca de aquí.",
   "en": "Nice to meet you. I've just moved to Madrid. I live near here.",
   "who": "Elena",
   "audio": "audio/c2_04_Elena.mp3"
  },
  {
   "t": "d",
   "es": "¡Bienvenida! ¿Quieres un [[c2_vaso_de_agua|vaso de agua]]?",
   "en": "Welcome! Would you like a glass of water?",
   "who": "Javier",
   "audio": "audio/c2_05_Javier.mp3"
  },
  {
   "t": "d",
   "es": "Sí, gracias. Hoy estoy muy concentrada.",
   "en": "Yes, thanks. I'm very focused today.",
   "who": "Elena",
   "audio": "audio/c2_06_Elena.mp3"
  },
  {
   "t": "d",
   "es": "¿Trabajas con el ordenador todo el día?",
   "en": "Do you work on the computer all day?",
   "who": "Javier",
   "audio": "audio/c2_07_Javier.mp3"
  },
  {
   "t": "d",
   "es": "Sí, casi todo el día.",
   "en": "Yes, almost all day.",
   "who": "Elena",
   "audio": "audio/c2_08_Elena.mp3"
  },
  {
   "t": "d",
   "es": "Pues a las cuatro voy al parque. ¿[[c2_vienes|Vienes]]?",
   "en": "Well, at four I'm going to the park. Are you coming?",
   "who": "Javier",
   "audio": "audio/c2_09_Javier.mp3"
  },
  {
   "t": "d",
   "es": "¡Vale! Necesito descansar un poco.",
   "en": "OK! I need to rest a bit.",
   "who": "Elena",
   "audio": "audio/c2_10_Elena.mp3"
  },
  {
   "t": "d",
   "es": "Hay un banco de madera muy tranquilo.",
   "en": "There's a very quiet wooden bench.",
   "who": "Javier",
   "audio": "audio/c2_11_Javier.mp3"
  },
  {
   "t": "d",
   "es": "Perfecto. [[c2_nos_vemos_a_las_cuatro|Nos vemos a las cuatro]].",
   "en": "Perfect. See you at four.",
   "who": "Elena",
   "audio": "audio/c2_12_Elena.mp3"
  },
  {
   "t": "h",
   "es": "3 · En el mercado (jueves, 10:30)",
   "en": ""
  },
  {
   "t": "d",
   "es": "Buenos días. ¿Qué te pongo?",
   "en": "Good morning. What can I get you?",
   "who": "Frutero",
   "audio": "audio/c3_01_Frutero.mp3"
  },
  {
   "t": "d",
   "es": "Buenos días. Quiero tomates, por favor.",
   "en": "Good morning. I'd like some tomatoes, please.",
   "who": "Elena",
   "audio": "audio/c3_02_Elena.mp3"
  },
  {
   "t": "d",
   "es": "¿[[c3_cuantos_quieres|Cuántos quieres]]?",
   "en": "How many would you like?",
   "who": "Frutero",
   "audio": "audio/c3_03_Frutero.mp3"
  },
  {
   "t": "d",
   "es": "[[c3_medio_kilo|Medio kilo]].",
   "en": "Half a kilo.",
   "who": "Elena",
   "audio": "audio/c3_04_Elena.mp3"
  },
  {
   "t": "d",
   "es": "Muy bien. ¿Algo más?",
   "en": "Very good. Anything else?",
   "who": "Frutero",
   "audio": "audio/c3_05_Frutero.mp3"
  },
  {
   "t": "d",
   "es": "Sí, un [[c3_pepino_y_un_pimiento_roj|pepino y un pimiento rojo]].",
   "en": "Yes, a cucumber and a red pepper.",
   "who": "Elena",
   "audio": "audio/c3_06_Elena.mp3"
  },
  {
   "t": "d",
   "es": "¿Vas a hacer una ensalada?",
   "en": "Are you going to make a salad?",
   "who": "Frutero",
   "audio": "audio/c3_07_Frutero.mp3"
  },
  {
   "t": "d",
   "es": "Sí, una ensalada simple. Voy a cocinar en casa.",
   "en": "Yes, a simple salad. I'm going to cook at home.",
   "who": "Elena",
   "audio": "audio/c3_08_Elena.mp3"
  },
  {
   "t": "d",
   "es": "¡Qué rica! Son tres euros con veinte.",
   "en": "Yummy! That's three euros twenty.",
   "who": "Frutero",
   "audio": "audio/c3_09_Frutero.mp3"
  },
  {
   "t": "d",
   "es": "¿[[c3_puedo_pagar_con_tarjeta|Puedo pagar con tarjeta]]?",
   "en": "Can I pay by card?",
   "who": "Elena",
   "audio": "audio/c3_10_Elena.mp3"
  },
  {
   "t": "d",
   "es": "Claro. ¿[[c3_tienes_bolsa|Tienes bolsa]]?",
   "en": "Of course. Do you have a bag?",
   "who": "Frutero",
   "audio": "audio/c3_11_Frutero.mp3"
  },
  {
   "t": "d",
   "es": "Sí, tengo mi bolsa de tela.",
   "en": "Yes, I have my cloth bag.",
   "who": "Elena",
   "audio": "audio/c3_12_Elena.mp3"
  },
  {
   "t": "d",
   "es": "¡Muy bien! [[c3_hasta_la_proxima|Hasta la próxima]].",
   "en": "Great! Until next time.",
   "who": "Frutero",
   "audio": "audio/c3_13_Frutero.mp3"
  },
  {
   "t": "d",
   "es": "Gracias, ¡hasta luego!",
   "en": "Thanks, see you!",
   "who": "Elena",
   "audio": "audio/c3_14_Elena.mp3"
  },
  {
   "t": "h",
   "es": "4 · En la cafetería (viernes, 16:00)",
   "en": ""
  },
  {
   "t": "d",
   "es": "Hola, buenas tardes. ¿[[c4_que_vas_a_tomar|Qué vas a tomar]]?",
   "en": "Hi, good afternoon. What are you having?",
   "who": "Camarera",
   "audio": "audio/c4_01_Camarera.mp3"
  },
  {
   "t": "d",
   "es": "Hola. Un café con leche, por favor.",
   "en": "Hi. A white coffee, please.",
   "who": "Elena",
   "audio": "audio/c4_02_Elena.mp3"
  },
  {
   "t": "d",
   "es": "¿Para tomar aquí o para llevar?",
   "en": "To have here or to take away?",
   "who": "Camarera",
   "audio": "audio/c4_03_Camarera.mp3"
  },
  {
   "t": "d",
   "es": "Para tomar aquí. Es la [[c4_primera_vez|primera vez]] que vengo.",
   "en": "To have here. It's my first time here.",
   "who": "Elena",
   "audio": "audio/c4_04_Elena.mp3"
  },
  {
   "t": "d",
   "es": "¡Bienvenida! Siéntate donde quieras.",
   "en": "Welcome! Sit wherever you like.",
   "who": "Camarera",
   "audio": "audio/c4_05_Camarera.mp3"
  },
  {
   "t": "d",
   "es": "Gracias. ¿Puedo sentarme junto a la ventana?",
   "en": "Thanks. Can I sit by the window?",
   "who": "Elena",
   "audio": "audio/c4_06_Elena.mp3"
  },
  {
   "t": "d",
   "es": "Claro… Aquí tienes tu café.",
   "en": "Of course… Here's your coffee.",
   "who": "Camarera",
   "audio": "audio/c4_07_Camarera.mp3"
  },
  {
   "t": "d",
   "es": "Gracias. [[c4_me_siento_a_gusto|Me siento a gusto]] aquí.",
   "en": "Thanks. I feel comfortable here.",
   "who": "Elena",
   "audio": "audio/c4_08_Elena.mp3"
  },
  {
   "t": "d",
   "es": "¿Qué estás leyendo?",
   "en": "What are you reading?",
   "who": "Camarera",
   "audio": "audio/c4_09_Camarera.mp3"
  },
  {
   "t": "d",
   "es": "Un libro en español. Leo un poco cada día.",
   "en": "A book in Spanish. I read a little every day.",
   "who": "Elena",
   "audio": "audio/c4_10_Elena.mp3"
  },
  {
   "t": "d",
   "es": "¡Qué bien! ¿Quieres algo más?",
   "en": "How nice! Would you like anything else?",
   "who": "Camarera",
   "audio": "audio/c4_11_Camarera.mp3"
  },
  {
   "t": "d",
   "es": "No, gracias. ¿[[c4_cuanto_es|Cuánto es]]?",
   "en": "No, thanks. How much is it?",
   "who": "Elena",
   "audio": "audio/c4_12_Elena.mp3"
  },
  {
   "t": "d",
   "es": "Un euro con ochenta.",
   "en": "One euro eighty.",
   "who": "Camarera",
   "audio": "audio/c4_13_Camarera.mp3"
  },
  {
   "t": "d",
   "es": "Aquí tienes. ¡Hasta luego!",
   "en": "Here you are. See you!",
   "who": "Elena",
   "audio": "audio/c4_14_Elena.mp3"
  },
  {
   "t": "v",
   "es": "Frases clave de la semana"
  }
